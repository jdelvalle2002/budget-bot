# Telegram / WhatsApp Bot Config
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
WHATSAPP_API_KEY="your_whatsapp_api_key_here"

# Application Settings
USER_ID="your_allowed_user_id_here"
MAX_PAST_DAYS="60"

# Google Sheets / Drive API Credentials path
GOOGLE_APPLICATION_CREDENTIALS="path/to/your/credentials.json"
GOOGLE_SHEET_ID="your_google_sheet_id_here"

# Other configs
ENVIRONMENT="development"

# Configuración de Internacionalización (i18n), Formato y Tono
TZ_NAME="America/Santiago"
BOT_CONTEXT="Chile, usando pesos chilenos sin decimales."
BOT_TONE="constructivo y amable, pero manteniendo un toque humorístico"
# BOT_REGIONAL_STYLE="Opcional: instrucciones de modismos o estilo (por defecto usa modismos chilenos si el contexto es Chile)"
CURRENCY_SYMBOL="$"
CURRENCY_DECIMALS="0"
CURRENCY_POSITION="prefix"        # "prefix" (ej: $15,000) o "suffix" (ej: 15,000 $)
CURRENCY_DECIMAL_SEP="."          # "." o ","
CURRENCY_THOUSANDS_SEP=","        # "," o "." o " "

# Ejemplo de Configuración para Europa / Alemania (Euros):
# TZ_NAME="Europe/Munich"
# BOT_CONTEXT="Alemania, usando euros con decimales y hablando en español."
# BOT_TONE="constructivo y amable, con un toque de humor sutil"
# BOT_REGIONAL_STYLE="Habla en español relajado y cercano, comprensible para un hispanohablante viviendo en Europa, sin modismos forzados ni jerga chilena."
# CURRENCY_SYMBOL="€"
# CURRENCY_DECIMALS="2"
# CURRENCY_POSITION="suffix"
# CURRENCY_DECIMAL_SEP=","
# CURRENCY_THOUSANDS_SEP="."

# Gemini AI (Creatividad y comentarios)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_TEMPERATURE="0.9"
